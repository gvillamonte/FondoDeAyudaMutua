# ============================================================
# SISTEMA DE BENEFICIOS COLEGIALES - Variables de Entorno
# ============================================================
# Copiar este archivo a .env y completar los valores reales.

# ------------------------------------------------------------
# BASE DE DATOS LEGADO (Solo Lectura)
# Contiene el padrón maestro de colegiados.
# PROHIBIDO: INSERT, UPDATE, DELETE, TRUNCATE sobre esta DB.
#
# Autenticación SQL (recomendada, funciona en Windows y Linux):
# ------------------------------------------------------------
LEGACY_DB_SERVER="192.168.1.100"
LEGACY_DB_NAME="DBCIPCusco"
LEGACY_DB_PORT="1433"
LEGACY_DB_USER="legacy_readonly_user"
LEGACY_DB_PASSWORD="CHANGE_ME"
LEGACY_DB_ENCRYPT="true"
LEGACY_DB_TRUST_CERT="true"

# Alternativa: URL estilo tedious (tiene prioridad sobre lo anterior)
# LEGACY_DB_URL="sqlserver://legacy_readonly_user:CHANGE_ME@192.168.1.100:1433;database=DBCIPCusco;encrypt=true;trustServerCertificate=true"

# Solo Windows (dev local, requiere msnodesqlv8 + ODBC Driver 18):
# LEGACY_DB_URL="Driver={ODBC Driver 18 for SQL Server};Server=.\SQLEXPRESS;Database=DBCIPCusco;Trusted_Connection=Yes;TrustServerCertificate=Yes;"

# ------------------------------------------------------------
# BASE DE DATOS DE LA APLICACIÓN (Lectura/Escritura)
# Dominio de Beneficios, Pagos, Usuarios y Audit Log.
# ------------------------------------------------------------
APP_DB_URL="sqlserver://app_user:CHANGE_ME@192.168.1.100:1433;database=DBCIPBeneficios;encrypt=true;trustServerCertificate=true;connection timeout=30"

# ------------------------------------------------------------
# JWT / AUTENTICACIÓN
# ------------------------------------------------------------
JWT_SECRET="CHANGE_ME_TO_A_SECURE_RANDOM_STRING_MIN_32_CHARS"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="CHANGE_ME_TO_ANOTHER_SECURE_RANDOM_STRING_MIN_32_CHARS"
JWT_REFRESH_EXPIRATION="7d"

# ------------------------------------------------------------
# SERVIDOR
# ------------------------------------------------------------
NODE_ENV="production"
PORT=3001
CORS_ORIGIN="https://tudominio.com"

# ------------------------------------------------------------
# FRONTEND (Next.js)
# NEXT_PUBLIC_API_URL se inyecta en tiempo de BUILD (npm run build)
# INTERNAL_API_URL la usa Next en runtime para el rewrite /api/*
# ------------------------------------------------------------
NEXT_PUBLIC_API_URL="https://tudominio.com/api"
INTERNAL_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_NAME="Sistema de Beneficios Colegiales"

# ------------------------------------------------------------
# PRISMA
# ------------------------------------------------------------
PRISMA_LOG_LEVEL="query,error,warn,info"
