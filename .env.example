# ============================================================
# SISTEMA DE BENEFICIOS COLEGIALES - Variables de Entorno
# ============================================================
# Copiar este archivo a .env y completar los valores reales.

# ------------------------------------------------------------
# BASE DE DATOS LEGADO (Solo Lectura)
# Contiene el padrón maestro de colegiados.
# PROHIBIDO: INSERT, UPDATE, DELETE, TRUNCATE sobre esta DB.
# ------------------------------------------------------------
LEGACY_DB_URL="sqlserver://localhost:1433;database=DBCIPCusco;user=legacy_readonly_user;password=CHANGE_ME;encrypt=true;trustServerCertificate=true"
# Alternativa PostgreSQL:
# LEGACY_DB_URL="postgresql://legacy_user:CHANGE_ME@localhost:5432/DBCIPCusco?schema=public"

# ------------------------------------------------------------
# BASE DE DATOS DE LA APLICACIÓN (Lectura/Escritura)
# Dominio de Beneficios, Pagos, Usuarios y Audit Log.
# ------------------------------------------------------------
APP_DB_URL="postgresql://app_user:CHANGE_ME@localhost:5432/DBCIPBeneficios?schema=public"
# Alternativa SQL Server:
# APP_DB_URL="sqlserver://localhost:1433;database=DBCIPBeneficios;user=app_user;password=CHANGE_ME;encrypt=true;trustServerCertificate=true"

# ------------------------------------------------------------
# JWT / AUTENTICACIÓN
# ------------------------------------------------------------
JWT_SECRET="CHANGE_ME_TO_A_SECURE_RANDOM_STRING_MIN_32_CHARS"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="CHANGE_ME_TO_ANOTHER_SECURE_RANDOM_STRING_MIN_32_CHARS"
JWT_REFRESH_EXPIRATION="7d"

# ------------------------------------------------------------
# SERVIDOR
# ------------------------------------------------------------
NODE_ENV="development"
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# ------------------------------------------------------------
# FRONTEND (Next.js)
# ------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
NEXT_PUBLIC_APP_NAME="Sistema de Beneficios Colegiales"

# ------------------------------------------------------------
# PRISMA
# ------------------------------------------------------------
PRISMA_LOG_LEVEL="query,error,warn,info"
